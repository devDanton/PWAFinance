# ==============================================================================
# PWA Finance - Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env.local:
#   cp .env.example .env.local
# E preencha com as credenciais do seu projeto Supabase.
# ==============================================================================

# URL base da API do Supabase (Project Settings > API > Project URL)
# Exemplo: https://xyzcompanyproject.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima / pública do Supabase (Project Settings > API > Project API keys > anon public)
# Utilizada no cliente Next.js e SSR para autenticação com RLS (Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

